# ── Personal data & secrets ──────────────────────────────────────────
# .env.example (template, no real values) is fine to commit
.env
.env.*
!.env.example

secrets/
*.pem
*.key

# ── Runtime state ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
databrokergo.db

# ── OS / editor ───────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── Local dev tool config (not meant for public consumption) ──────────
.claude/settings.local.json

# ── Go build artifacts ────────────────────────────────────────────────
# NB: gitignore has no trailing-comment support - "/databrokergo  # compiled
# binary" was being read as one literal pattern, so the 24MB binary was never
# actually ignored. Comments get their own line.
/databrokergo
/unbrokerrdd
dist/

# Gmail OAuth: client secret and bearer refresh token. Never commit.
gmail_credentials.json
gmail_token.json

# Private incident notes and working material — never published.
/private/
