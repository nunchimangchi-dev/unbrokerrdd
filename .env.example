# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real values.
#
# Minimal data principle: only include what CCPA legally requires.
# Do NOT add SSN, DOB, or anything beyond name + contact.

SUBJECT_NAME="First Last"
SUBJECT_EMAIL="your@email.com"
SUBJECT_STATE="OH"            # Two-letter state code — used in CCPA template

# Optional — only include if needed for specific opt-out forms
# SUBJECT_ADDRESS="123 Main St, City, OH 44000"

# Anthropic API — never log, never expose in dashboard
ANTHROPIC_API_KEY="sk-ant-..."

# Gmail sender address (must match authenticated Gmail MCP account)
GMAIL_SENDER="your@email.com"
